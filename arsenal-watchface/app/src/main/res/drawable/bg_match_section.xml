<?xml version="1.0" encoding="utf-8"?>
<!-- Match day section background -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Navy fill -->
    <solid android:color="#E60A1628" />

    <!-- Aqua accent border -->
    <stroke
        android:width="1dp"
        android:color="#4D00D4AA" />

    <!-- Rounded corners -->
    <corners android:radius="15dp" />

    <size
        android:width="320dp"
        android:height="100dp" />
</shape>
